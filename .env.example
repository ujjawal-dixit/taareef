# Taareef — environment variables
#
# Every variable below is READ BY CODE. Verified 2026-08-18 by enumerating
# every `process.env.*` reference in app/ and lib/.
#
# T-rule: update this file in the SAME PR that introduces a new variable.
# Four keys were missing here for several sessions; the failure mode is silent
# — enrichment just quietly returns nothing for the affected category.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://taareef.vercel.app

# ── Groq — capture: Whisper (voice), vision (OCR), Llama (extraction) ───────
# Model IDs live in lib/constants/models.ts. Never hardcode one in a route.
GROQ_API_KEY=gsk_your-groq-key

# ── Enrichment ──────────────────────────────────────────────────────────────
TMDB_API_KEY=your-tmdb-key                      # watch
SPOTIFY_CLIENT_ID=your-spotify-client-id        # listen
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
GOOGLE_BOOKS_API_KEY=your-google-books-key      # read
GOOGLE_PLACES_API_KEY=your-google-places-key    # dine · visit · do
WATCHMODE_API_KEY=your-watchmode-key            # streaming platforms

# ── Alerts ──────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your-resend-key
FOUNDER_EMAIL=your@email.com

# ── Cron ────────────────────────────────────────────────────────────────────
# Vercel sends this as `Authorization: Bearer $CRON_SECRET` to scheduled
# routes (/api/health/models, /api/health/database). Optional: without it the
# health routes fall back to requiring a signed-in user.
CRON_SECRET=any-long-random-string
