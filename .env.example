# =============================================================
# Taareef — Environment Variables
# =============================================================
# This file is safe to commit. It contains no real values.
# In Vercel: add real values under Settings → Environment Variables
# Set for Production and Preview environments only.
# The Development environment is locked on Vercel Hobby plan.
# =============================================================


# -------------------------------------------------------------
# SUPABASE — Required for V1
# Find these under: Supabase Dashboard → Settings → API Keys → Legacy tab
# -------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# -------------------------------------------------------------
# APP — Required for V1
# Your Vercel deployment URL (no trailing slash)
# -------------------------------------------------------------

NEXT_PUBLIC_APP_URL=https://taareef.vercel.app


# -------------------------------------------------------------
# ANTHROPIC — Required for V2 (/api/parse endpoint)
# Commented out until V2 build begins
# -------------------------------------------------------------

# Server-only — NEVER prefix with NEXT_PUBLIC_
# ANTHROPIC_API_KEY=sk-ant-api03-your-key-here


# -------------------------------------------------------------
# V2 ENRICHMENT APIs — Add when building V2
# -------------------------------------------------------------

# Google Places API (restaurant/bar enrichment)
# GOOGLE_PLACES_API_KEY=your-google-places-key-here

# TMDB (film/TV enrichment)
# TMDB_API_KEY=your-tmdb-api-key-here

# Spotify (music enrichment)
# SPOTIFY_CLIENT_ID=your-spotify-client-id-here
# SPOTIFY_CLIENT_SECRET=your-spotify-client-secret-here

# Shazam via RapidAPI (music recognition — non-iOS)
# SHAZAM_API_KEY=your-rapidapi-key-here
